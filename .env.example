# ───────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the values.
# Never commit .env.local — it holds your secrets.
# ───────────────────────────────────────────────────────────────

# Admin (backend) password. REQUIRED — with it unset nobody can log in.
ADMIN_PASSWORD=change-me
# Optional: separate secret for signing admin session cookies. If unset, the
# password itself is used (so changing the password logs everyone out).
# ADMIN_SESSION_SECRET=

# Public base URL used in QR codes and student links (no trailing slash).
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── AI (packyapi / OpenAI-compatible relay) ──────────────────────
# Get a key at https://www.packyapi.com . Leave AI_API_KEY empty to run
# in MOCK mode (the whole flow works with canned answers, no key needed).
AI_API_KEY=
AI_BASE_URL=https://www.packyapi.com/v1
AI_MODEL=claude-opus-4-8

# ── Talking-avatar (digital human) provider ──────────────────────
# AVATAR_PROVIDER = mock | a2e | did
#   mock : no video; the photo "speaks" via the browser's built-in voice
#          (fully working demo, zero cost, no key required)
#   a2e  : domestic (China-friendly) provider via A2E (https://video.a2e.com.cn)
#          — needs A2E_API_KEY. Recommended in China.
#   did  : real-time lip-sync via D-ID — needs DID_API_KEY (blocked in mainland China)
AVATAR_PROVIDER=mock

# A2E. Get a token in Account > API Token.
A2E_API_KEY=
# A2E_MODE = fast | precise
#   fast    (default): per-answer TTS audio played over the person's one-time
#           "talking loop" video — answers start in seconds.
#   precise: per-answer lip-sync render — accurate mouth movement, but tens of
#           seconds per answer and may hit serverless time limits.
A2E_MODE=fast
# Voice ids (from /api/v1/anchor/voice_list). Defaults are multilingual (zh+en):
# male "Andrew" 66d3fb1bc051cfb134c60f20, female "Emma" 66d3fb89357648b14c4f4f26.
# A2E_TTS_ID_MALE=
# A2E_TTS_ID_FEMALE=
# A2E_TTS_ID=            # fallback when a person has no voice gender set
# A2E_CARTOON_MODEL=nano-banana-pro

# D-ID (real-time streaming; not usable from mainland China)
DID_API_KEY=
DID_VOICE_ID=en-US-JennyNeural

# ── Storage ──────────────────────────────────────────────────────
# No filesystem persistence on Vercel, so the app uses Vercel Blob there.
# You do NOT set this by hand — Vercel injects BLOB_READ_WRITE_TOKEN once you
# connect a Blob store to the project. When present, the app stores photos +
# data in Blob automatically; when absent (local dev), it uses ./data files.
# BLOB_READ_WRITE_TOKEN=
